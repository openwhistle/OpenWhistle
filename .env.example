# Required
DATABASE_URL=postgresql+asyncpg://openwhistle:openwhistle@localhost:5432/openwhistle
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-long-random-secret-key-here

# Root key for encryption at rest (recommended; unset: SECRET_KEY is used).
# On an existing install, do not just set it: follow "Rotating the encryption
# key" in the docs — the current key must go into ENCRYPTION_KEY_PREVIOUS.
# Old keys go in ENCRYPTION_KEY_PREVIOUS (comma-separated, no spaces).
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# First-run setup: leave unset to have the app generate a token and print it
# once to the log (docker compose logs app | grep "Setup token"). Set it to
# skip that lookup, or to pin the token across every replica (32+ characters,
# e.g. openssl rand -hex 16).
SETUP_TOKEN=

# Application
APP_NAME=OpenWhistle
DEMO_MODE=false

# OIDC (optional)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=
OIDC_REDIRECT_URI=

# Branding (optional)
BRAND_PRIMARY_COLOR=#0f4c81
BRAND_LOGO_URL=

# Production database credentials (for docker-compose.prod.yml)
POSTGRES_USER=openwhistle
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# App image tag for docker-compose.prod.yml. Bumped by the release checklist.
OPENWHISTLE_VERSION=1.6.0

# Hostname for the self-signed TLS certificate the bundled nginx generates
# when nginx/certs/ has no fullchain.pem + privkey.pem of your own. Compose-only,
# used by the tls-init service (docker-compose.prod.yml); not an app setting.
TLS_HOSTNAME=localhost
