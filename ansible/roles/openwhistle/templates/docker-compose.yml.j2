services:
  app:
    image: {{ openwhistle_image }}:{{ openwhistle_image_tag }}
    env_file: .env
    read_only: true
    tmpfs:
      - /tmp:size=128m
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: always
    networks:
      - internal
      - proxy

  nginx:
    image: nginx:alpine
    read_only: true
    tmpfs:
      - /tmp:size=128m
      - /var/cache/nginx:size=128m
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
    volumes:
      # :z relabels for SELinux hosts (shared label; a no-op elsewhere). Never
      # :Z on /etc/letsencrypt — certbot on the host writes there too.
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
      - /etc/letsencrypt:/etc/letsencrypt:ro,z
    depends_on:
      - app
    restart: always
    networks:
      - proxy

  db:
    image: postgres:18-alpine
    env_file: .env
    security_opt:
      - no-new-privileges:true
    environment:
      # postgres:18 defaults PGDATA to /var/lib/postgresql/18/docker and refuses
      # to start when /var/lib/postgresql/data is mounted without this.
      PGDATA: /var/lib/postgresql/data
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    networks:
      - internal

  redis:
    image: redis:8-alpine
    security_opt:
      - no-new-privileges:true
    # noeviction: sessions and rate-limit counters are never dropped; drafts
    # stop taking attachments at DRAFT_REDIS_MEMORY_PERCENT of maxmemory.
    command: redis-server --save "" --appendonly no --maxmemory {{ openwhistle_redis_maxmemory }} --maxmemory-policy noeviction --requirepass "${REDIS_PASSWORD}"
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    networks:
      - internal

volumes:
  postgres_data:

networks:
  internal:
    driver: bridge
    internal: true
  proxy:
    driver: bridge
