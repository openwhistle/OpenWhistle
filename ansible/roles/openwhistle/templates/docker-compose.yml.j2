services:
  app:
    image: {{ openwhistle_image }}:{{ openwhistle_image_tag }}
    env_file: .env
    read_only: true
    tmpfs:
      - /tmp:size=128m
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: always
    networks:
      - internal
      - proxy

  nginx:
    image: nginx:alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
    read_only: true
    tmpfs:
      - /tmp:size=128m
      - /var/cache/nginx:size=128m
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
      # Onion service entry point — reachable only from the host running tor.
      - "127.0.0.1:8080:8080"
    volumes:
      # :z relabels for SELinux hosts (shared label; a no-op elsewhere). Never
      # :Z on /etc/letsencrypt — certbot on the host writes there too.
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
      - ./nginx/snippets:/etc/nginx/snippets:ro,z
      - /etc/letsencrypt:/etc/letsencrypt:ro,z
    depends_on:
      - app
    restart: always
    networks:
      - proxy

  db:
    image: postgres:18-alpine@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5
    read_only: true
    tmpfs:
      - /var/run/postgresql
      - /tmp
    # The entrypoint hands the data directory to postgres and drops to it; nothing else.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    # Not `env_file: .env`: that put SECRET_KEY, ENCRYPTION_KEY and the OIDC, LDAP, SMTP
    # and S3 secrets into the database container's environment. Only what it needs,
    # interpolated from .env by compose.
    environment:
      POSTGRES_USER: "${POSTGRES_USER}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
      POSTGRES_DB: "${POSTGRES_DB}"
      # postgres:18 defaults PGDATA to /var/lib/postgresql/18/docker and refuses
      # to start when /var/lib/postgresql/data is mounted without this.
      PGDATA: /var/lib/postgresql/data
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    networks:
      - internal

  redis:
    image: redis:8-alpine@sha256:21090af93f8324db2f0f0f4f38a7c60369d47d917e000c3423d89d2ae2883537
    read_only: true
    # The entrypoint drops from root to the redis user; nothing else.
    cap_drop:
      - ALL
    cap_add:
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    # noeviction: sessions and rate-limit counters are never dropped; drafts
    # stop taking attachments at DRAFT_REDIS_MEMORY_PERCENT of maxmemory.
    command: redis-server --save "" --appendonly no --maxmemory {{ openwhistle_redis_maxmemory }} --maxmemory-policy noeviction --requirepass "${REDIS_PASSWORD:?REDIS_PASSWORD is required (empty means Redis without authentication)}"
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:?REDIS_PASSWORD is required (empty means Redis without authentication)}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    networks:
      - internal

  # Optional upload virus scan. Off unless CLAMAV_HOST is set and
  # this profile is enabled: `COMPOSE_PROFILES=clamav`. Not reachable from the
  # host, and not on `proxy` — nginx has no business reaching clamd, so it
  # shares only `internal` with `app`. `internal` has no internet access, but
  # freshclam (signature updates) needs one to reach database.clamav.net,
  # hence its own `clamav-egress` network instead of the shared `proxy` one.
  clamav:
    image: clamav/clamav:1.5.4@sha256:bda39705e291105049c3936e2803ac90b955172af8030f94f05dce1252df6c6d
    profiles: ["clamav"]
    restart: always
    read_only: true
    tmpfs:
      - /tmp:size=64m
      - /run:size=16m
      - /var/log/clamav:size=16m
    volumes:
      - clamav_data:/var/lib/clamav
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - FOWNER
      - SETUID
      - SETGID
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "clamdcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 6m
    networks:
      - internal
      - clamav-egress

volumes:
  postgres_data:
  clamav_data:

networks:
  internal:
    driver: bridge
    internal: true
  # clamd's only route to the internet (freshclam signature updates). Used by
  # no other service — in particular, not shared with nginx's `proxy` network.
  clamav-egress:
    driver: bridge
  proxy:
    driver: bridge
