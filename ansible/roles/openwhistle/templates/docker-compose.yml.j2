services:
  app:
    image: {{ openwhistle_image }}:{{ openwhistle_image_tag }}
    env_file: .env
    read_only: true
    tmpfs:
      - /tmp:size=128m
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: always
    networks:
      - internal
      - proxy

  nginx:
    image: nginx:alpine
    read_only: true
    tmpfs:
      - /tmp:size=128m
      - /var/cache/nginx:size=128m
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
    volumes:
      # :z relabels for SELinux hosts (shared label; a no-op elsewhere). Never
      # :Z on /etc/letsencrypt — certbot on the host writes there too.
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
      - /etc/letsencrypt:/etc/letsencrypt:ro,z
    depends_on:
      - app
    restart: always
    networks:
      - proxy

  db:
    image: postgres:18-alpine
    env_file: .env
    security_opt:
      - no-new-privileges:true
    environment:
      # postgres:18 defaults PGDATA to /var/lib/postgresql/18/docker and refuses
      # to start when /var/lib/postgresql/data is mounted without this.
      PGDATA: /var/lib/postgresql/data
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    networks:
      - internal

  redis:
    image: redis:8-alpine
    security_opt:
      - no-new-privileges:true
    # noeviction: sessions and rate-limit counters are never dropped; drafts
    # stop taking attachments at DRAFT_REDIS_MEMORY_PERCENT of maxmemory.
    command: redis-server --save "" --appendonly no --maxmemory {{ openwhistle_redis_maxmemory }} --maxmemory-policy noeviction --requirepass "${REDIS_PASSWORD}"
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    networks:
      - internal

  # Optional upload virus scan (Task 20). Off unless CLAMAV_HOST is set and
  # this profile is enabled: `COMPOSE_PROFILES=clamav`. Not reachable from the
  # host, and not on `proxy` — nginx has no business reaching clamd, so it
  # shares only `internal` with `app`. `internal` has no internet access, but
  # freshclam (signature updates) needs one to reach database.clamav.net,
  # hence its own `clamav-egress` network instead of the shared `proxy` one.
  clamav:
    image: clamav/clamav:1.4@sha256:a5f03c12a79dbe9f6d8a527b6bb1ea053fa8dd061d3738a26897f055ee2d9303
    profiles: ["clamav"]
    restart: always
    read_only: true
    tmpfs:
      - /tmp:size=64m
      - /run:size=16m
      - /var/log/clamav:size=16m
    volumes:
      - clamav_data:/var/lib/clamav
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - FOWNER
      - SETUID
      - SETGID
      - DAC_OVERRIDE
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "clamdcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 6m
    networks:
      - internal
      - clamav-egress

volumes:
  postgres_data:
  clamav_data:

networks:
  internal:
    driver: bridge
    internal: true
  # clamd's only route to the internet (freshclam signature updates). Used by
  # no other service — in particular, not shared with nginx's `proxy` network.
  clamav-egress:
    driver: bridge
  proxy:
    driver: bridge
