# OpenWhistle environment — managed by Ansible, do not edit manually
# Generated: {{ ansible_date_time.iso8601 }}
{#
  Every value is single-quoted: this file is both env_file and Compose's
  interpolation source, and unquoted, Compose expands `$` (pa$$w0rd$HOME
  reached the container as pa$w0rd/home/...). Inside single quotes only \'
  is an escape.
  ponytail: a value ending in a backslash or holding a newline still cannot
  be written; openssl rand output never does.
#}
{%- macro q(value) -%}
'{{ value | string | replace("'", "\\'") }}'
{%- endmacro -%}
{%- macro pw(value) -%}
{{ value | string | urlencode | replace('/', '%2F') }}
{%- endmacro %}

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL={{ q('postgresql+asyncpg://' ~ openwhistle_db_user ~ ':' ~ pw(openwhistle_db_password) ~ '@db:5432/' ~ openwhistle_db_name) }}
POSTGRES_USER={{ q(openwhistle_db_user) }}
POSTGRES_PASSWORD={{ q(openwhistle_db_password) }}
POSTGRES_DB={{ q(openwhistle_db_name) }}

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL={{ q('redis://:' ~ pw(openwhistle_redis_password) ~ '@redis:6379/0') }}
REDIS_PASSWORD={{ q(openwhistle_redis_password) }}

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY={{ q(openwhistle_secret_key) }}
# Root of at-rest encryption, >= 32 chars; empty = SECRET_KEY (see docs
# "Rotating the encryption key" before changing it on an existing install).
ENCRYPTION_KEY={{ q(openwhistle_encryption_key) }}
# Every commented line below is an optional app/config.py setting at its
# built-in default. Set it through openwhistle_env (see the end of this file);
# an edit here is overwritten on the next run.
# ENCRYPTION_KEY_PREVIOUS=                 # comma-separated old keys accepted for decryption during a rotation
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# SESSION_MAX_HOURS=12                     # absolute admin session lifetime, never extended by "stay signed in"
# SECURE_COOKIES=true                      # set false only when served over plain HTTP (local network, no TLS)
# LOCAL_REVIEW_LOGIN=false                 # local review / e2e stack only — one-click admin login with no password or MFA; never true here (demo.openwhistle.net is deployed from this role)
# SETUP_TOKEN=                             # 32+ characters; unset: a random token is generated at startup and logged once

# ── Rate limiting & lockouts (optional) ───────────────────────────────────────
# MAX_ACCESS_ATTEMPTS=5                    # whistleblower case-number/PIN attempts
# ACCESS_LOCKOUT_MINUTES=15
# MAX_LOGIN_ATTEMPTS=10                    # admin password attempts
# LOGIN_LOCKOUT_MINUTES=30
# ADMIN_FAILED_LOGIN_ALERT_THRESHOLD=50    # password-spraying alarm, instance-wide; 0 disables
# ADMIN_FAILED_LOGIN_ALERT_WINDOW_MINUTES=15

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME={{ q(openwhistle_app_name) }}
APP_PUBLIC_URL={{ q(openwhistle_app_public_url) }}
DEMO_MODE={{ q(openwhistle_demo_mode) }}
SUBMISSION_MODE_ENABLED={{ q(openwhistle_submission_mode_enabled) }}
LOG_LEVEL={{ q(openwhistle_log_level) }}
LOG_FORMAT={{ q(openwhistle_log_format) }}
# DRAFT_REDIS_MEMORY_PERCENT=80            # refuse new draft attachments past this share of Redis maxmemory
# ONION_LOCATION=                          # e.g. http://<56 chars>.onion — see docs "Offering an onion address"

# ── Branding ──────────────────────────────────────────────────────────────────
BRAND_PRIMARY_COLOR={{ q(openwhistle_brand_primary_color) }}
BRAND_LOGO_URL={{ q(openwhistle_brand_logo_url) }}

# ── OIDC ──────────────────────────────────────────────────────────────────────
OIDC_ENABLED={{ q(openwhistle_oidc_enabled) }}
OIDC_CLIENT_ID={{ q(openwhistle_oidc_client_id) }}
OIDC_CLIENT_SECRET={{ q(openwhistle_oidc_client_secret) }}
OIDC_SERVER_METADATA_URL={{ q(openwhistle_oidc_server_metadata_url) }}
OIDC_REDIRECT_URI={{ q(openwhistle_oidc_redirect_uri) }}

# ── LDAP ──────────────────────────────────────────────────────────────────────
LDAP_ENABLED={{ q(openwhistle_ldap_enabled) }}
LDAP_SERVER={{ q(openwhistle_ldap_server) }}
LDAP_PORT={{ q(openwhistle_ldap_port) }}
LDAP_USE_SSL={{ q(openwhistle_ldap_use_ssl) }}
# LDAP_START_TLS=false                     # upgrade a plain connection (port 389) before any bind
LDAP_BIND_DN={{ q(openwhistle_ldap_bind_dn) }}
LDAP_BIND_PASSWORD={{ q(openwhistle_ldap_bind_password) }}
LDAP_BASE_DN={{ q(openwhistle_ldap_base_dn) }}
LDAP_USER_FILTER={{ q(openwhistle_ldap_user_filter) }}
LDAP_ATTR_USERNAME={{ q(openwhistle_ldap_attr_username) }}
LDAP_ATTR_EMAIL={{ q(openwhistle_ldap_attr_email) }}

# ── S3 storage ────────────────────────────────────────────────────────────────
STORAGE_BACKEND={{ q(openwhistle_storage_backend) }}
S3_ENDPOINT_URL={{ q(openwhistle_s3_endpoint_url) }}
S3_BUCKET_NAME={{ q(openwhistle_s3_bucket_name) }}
S3_ACCESS_KEY_ID={{ q(openwhistle_s3_access_key_id) }}
S3_SECRET_ACCESS_KEY={{ q(openwhistle_s3_secret_access_key) }}
S3_REGION={{ q(openwhistle_s3_region) }}
S3_PREFIX={{ q(openwhistle_s3_prefix) }}

# ── SLA reminders ─────────────────────────────────────────────────────────────
REMINDER_ENABLED={{ q(openwhistle_reminder_enabled) }}
REMINDER_ACK_WARN_DAYS={{ q(openwhistle_reminder_ack_warn_days) }}
REMINDER_FEEDBACK_WARN_DAYS={{ q(openwhistle_reminder_feedback_warn_days) }}

# ── Email notifications ───────────────────────────────────────────────────────
NOTIFY_EMAIL_ENABLED={{ q(openwhistle_notify_email_enabled) }}
NOTIFY_EMAIL_TO={{ q(openwhistle_notify_email_to) }}
NOTIFY_EMAIL_FROM={{ q(openwhistle_notify_email_from) }}
NOTIFY_SMTP_HOST={{ q(openwhistle_notify_smtp_host) }}
NOTIFY_SMTP_PORT={{ q(openwhistle_notify_smtp_port) }}
NOTIFY_SMTP_USER={{ q(openwhistle_notify_smtp_user) }}
NOTIFY_SMTP_PASSWORD={{ q(openwhistle_notify_smtp_password) }}
NOTIFY_SMTP_TLS={{ q(openwhistle_notify_smtp_tls) }}
NOTIFY_SMTP_SSL={{ q(openwhistle_notify_smtp_ssl) }}

# ── Webhook notifications ─────────────────────────────────────────────────────
NOTIFY_WEBHOOK_ENABLED={{ q(openwhistle_notify_webhook_enabled) }}
NOTIFY_WEBHOOK_URL={{ q(openwhistle_notify_webhook_url) }}
NOTIFY_WEBHOOK_SECRET={{ q(openwhistle_notify_webhook_secret) }}
NOTIFY_WEBHOOK_TYPE={{ q(openwhistle_notify_webhook_type) }}
# NOTIFICATION_BATCH_MINUTES=1440          # new-report/message notices sent as one digest every N minutes; 0 = immediate

# ── Data retention (optional; GDPR Art. 5 / HinSchG §11 Abs. 5) ──────────────
# RETENTION_ENABLED=true                   # on by default since v1.5.0
# RETENTION_DAYS=1095                      # 3 years

# ── Multi-tenancy (optional) ──────────────────────────────────────────────────
# MULTI_TENANCY_ENABLED=false
# DEFAULT_ORG_SLUG=default

# ── Update check (optional) ───────────────────────────────────────────────────
# UPDATE_CHECK_ENABLED=false               # daily check against the GitHub Releases API; no instance data sent
# TELEMETRY_ENABLED=                       # installation count: empty = in-app switch (off until agreed), false = always off, true = always on

# ── Virus scanning (optional) ─────────────────────────────────────────────────
# CLAMAV_HOST=                             # clamd hostname; empty = scanning off, uploads never checked
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=30                # an unreachable/slow clamd refuses the upload (fail closed)

# ── Anything else (openwhistle_env) ───────────────────────────────────────────
{% for key, value in openwhistle_env | dictsort %}
{{ key }}={{ q(value) }}
{% endfor %}
