   "old": ".submit-step-actions {\n  align-items: center;\n  display: flex;\n}\n/* Label stacked over value, not side-by-side: a fixed label column cannot\n   fit the longest label in every locale (\"EINREICHUNGSMODUS\" overlapped its\n   value) without either wasting space for short labels or being wide for\n   short ones — stacking fits every locale with no per-language tuning. */\n.review-row {\n  border-bottom-width: 1px;\n  border-color: var(--hairline);\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  padding-bottom: 0.625rem;\n  padding-top: 0.625rem;\n}\n.review-row:last-child {\n  border-bottom-width: 0;\n}\n.review-label {\n  color: var(--muted);\n  font-size: 0.75rem;\n  font-weight: 600;\n  letter-spacing: 0.07em;\n  line-height: 1rem;\n  text-transform: uppercase;\n}\n.review-value {\n  color: var(--body-text);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}",
