<mxfile>
  <diagram name="identity-reveal">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="open-case" value="Open case" style="ow:start" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="button" value="“Show identity” button" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="0" y="84" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="may-view" value="Role may&#xa;view case?" style="ow:decision" vertex="1" parent="1">
          <mxGeometry x="0" y="156" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="not-found" value="404, as today" style="ow:result" vertex="1" parent="1">
          <mxGeometry x="270" y="176" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="audit" value="Audit IDENTITY_REVEALED&#xa;user, reason" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="0" y="268" width="210" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="identity" value="Identity in this response&#xa;only, no cache" style="ow:end" vertex="1" parent="1">
          <mxGeometry x="0" y="352" width="210" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e-open" value="name and contact&#xa;not decrypted" style="ow:edge" edge="1" parent="1" source="open-case" target="button">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="58" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-post" value="POST + CSRF + reason" style="ow:edge;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="button" target="may-view">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="69" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-no" value="no" style="ow:edge;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="may-view" target="not-found">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-11"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-yes" value="yes" style="ow:edge;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="may-view" target="audit">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="18" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-audit" style="ow:edge" edge="1" parent="1" source="audit" target="identity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
