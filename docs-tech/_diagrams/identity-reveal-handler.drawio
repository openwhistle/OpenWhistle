<mxfile>
  <diagram name="identity-reveal-handler">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="get-case" value="GET case" style="ow:start" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="page" value="Page: identity hidden" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="0" y="72" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="handler" value="Handler?" style="ow:decision" vertex="1" parent="1">
          <mxGeometry x="0" y="144" width="190" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="forbidden" value="403" style="ow:result" vertex="1" parent="1">
          <mxGeometry x="250" y="160" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="revealed" value="IDENTITY_REVEALED&#xa;+ encrypted reason" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="0" y="260" width="190" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="same-page" value="Same page, identity in&#xa;this response only" style="ow:end" vertex="1" parent="1">
          <mxGeometry x="0" y="344" width="190" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e-viewed" value="REPORT_VIEWED" style="ow:edge" edge="1" parent="1" source="get-case" target="page">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="58" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-post" value="POST /identity + CSRF + reason" style="ow:edge;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="page" target="handler">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="96" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-yes" value="assigned to me, or&#xa;unassigned and I am admin" style="ow:edge;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="handler" target="revealed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="85" y="0"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-no" value="no" style="ow:edge;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handler" target="forbidden">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-11"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-revealed" style="ow:edge" edge="1" parent="1" source="revealed" target="same-page">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
