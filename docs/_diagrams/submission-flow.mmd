flowchart TD
    start(["Start a report"]) --> mode["1. Mode<br/>anonymous or confidential"]
    mode --> hasLoc{"Locations<br/>configured?"}
    hasLoc -- yes --> location["2. Location"]
    hasLoc -- no --> category
    location --> category["3. Category"]
    category --> details["4. Details<br/>description"]
    details --> files["5. Files<br/>attachments, optional"]
    files --> review["6. Review"]
    review --> submit(["Submit"])
    submit --> result["Case number + PIN<br/>issued once, shown once"]
