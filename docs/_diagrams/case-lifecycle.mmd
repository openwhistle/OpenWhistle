flowchart TD
    submitted(["Report submitted"]) --> received["received"]
    received --> in_review["in_review"]
    received --> closed["closed"]
    in_review --> pending_feedback["pending_feedback"]
    in_review --> closed
    in_review --> received
    pending_feedback --> closed
    pending_feedback --> in_review
    closed --> in_review

    ack["HinSchG: acknowledge<br/>within 7 days"]
    feedback["HinSchG: feedback<br/>within 3 months"]
    received -. deadline .-> ack
    pending_feedback -. deadline .-> feedback
