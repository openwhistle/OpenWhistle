<mxfile>
  <diagram name="admin-login">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="Admin login" style="ow:start" vertex="1" parent="1">
          <mxGeometry x="220" y="0" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="first-factor" value="First factor" style="ow:decision" vertex="1" parent="1">
          <mxGeometry x="220" y="72" width="220" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="database" value="Database" style="ow:store" vertex="1" parent="1">
          <mxGeometry x="0" y="200" width="180" height="56" as="geometry"/>
