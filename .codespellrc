[codespell]
skip = .git,./tests/e2e/vendor,.venv,.ruff_cache,.mypy_cache,.pytest_cache,uv.lock,htmlcov,*.woff2,*.png,*.ico,*.svg,.superpowers,.serena,.claude,CLAUDE.md,app/static/css/site.css,./app/locales/de.json,./app/locales/fr.json,./app/locales/es.json,./app/locales/pt-br.json,./docs-tech/plans
check-hidden = false
# covert — correct English legal term (secret recording), app/locales/en.json:431
# Tage — German text in changelog example, CHANGELOG.md:809
# Titel — German test data in test fixture, tests/test_coverage_gaps.py:838
# garantie — German test data in test fixture, tests/test_v150_ux.py:494
# ist — German text quoted in CHANGELOG.md and tests/test_v150_ux.py
# ALPH — WebP chunk name (alpha channel), app/services/attachment.py
ignore-words-list = ist,alph,covert,Tage,Titel,garantie
