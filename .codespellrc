[codespell]
skip = .git,.venv,uv.lock,htmlcov,*.woff2,*.png,*.ico,*.svg,.superpowers,.serena,.claude,CLAUDE.md,app/static/css/site.css,*/locales/*.json,docs/de/**,docs/blog/**,docs/hinschg_reference.md,docs-tech/plans/**
check-hidden = false
# German language content in documentation and German domain-specific terms
ignore-words-list = Alle,Aktion,Adresse,Assistent,als,alle,Aktive,aktive,Autor,autor,Dezember,Eine,eine,Ende,Erro,Frist,Funktion,HinSchG,Ist,ist,Juli,Klick,Paket,Plattform,Probleme,Prozess,Tage,Titel,Unser,Vor,vor,Sie,sie,oder,Oder,unter,froms,caracteres,nome,ser,adresse,manuell,garantie,startet
