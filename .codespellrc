[codespell]
skip = .git,.venv,uv.lock,htmlcov,*.woff2,*.png,*.ico,*.svg,.superpowers,.serena,.claude,CLAUDE.md,app/static/css/site.css,./app/locales/de.json,./app/locales/fr.json,./app/locales/pt-br.json,./docs/de,./docs/blog,./docs/hinschg_reference.md,./docs-tech/plans
check-hidden = false
# Legitimate English word flagged as typo (legal term: secret/undisclosed recording)
# German text in changelog example (89d Tage verbleibend — bug description)
# German test data strings in test fixtures (Titel, ist, unter, oder, garantie)
ignore-words-list = covert,Tage,Titel,ist,unter,oder,garantie
